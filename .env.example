# Copy to .env and fill in. Never commit .env.
# Model names change often: confirm them with  python -m querycraft.llm --list-models
# (or https://ai.google.dev/gemini-api/docs/models and https://console.groq.com/docs/models)

# --- Model A: Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Model B: Llama, via Groq or local Ollama ---
LLAMA_BACKEND=groq            # groq | ollama
GROQ_API_KEY=
LLAMA_MODEL=llama-3.3-70b-versatile   # for ollama use a local tag, e.g. llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Generation / rate limiting ---
TEMPERATURE=0
MAX_OUTPUT_TOKENS=1024
CALL_DELAY_SECONDS=1.0        # pause between API calls (free-tier rate limits)
MAX_API_RETRIES=5             # retries with exponential backoff on rate-limit/server errors

# --- Safety layer ---
QUERY_TIMEOUT_SECONDS=5
ROW_LIMIT=500
