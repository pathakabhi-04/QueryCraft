# Copy to .env and fill in. Never commit .env.
# Model names change often: confirm them with  python -m querycraft.llm --list-models
# (or https://ai.google.dev/gemini-api/docs/models and https://console.groq.com/docs/models)

# --- Model A: Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Model B: open model, via Groq or local Ollama ---
# Groq retired its Llama chat models; on Groq use an open-weight model.
# Llama itself is available locally via Ollama (LLAMA_BACKEND=ollama, LLAMA_MODEL=llama3.2:3b).
LLAMA_BACKEND=groq            # groq | ollama
GROQ_API_KEY=
LLAMA_MODEL=openai/gpt-oss-120b      # for ollama use a local tag, e.g. llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_NUM_CTX=8192            # context window for ollama; V5 prompts need > 4096 tokens

# --- Generation / rate limiting ---
TEMPERATURE=0
# Thinking models spend output tokens on hidden reasoning; with MAX_OUTPUT_TOKENS=1024 that
# cut answers off mid-JSON. Keep hidden reasoning minimal so the prompt techniques
# (e.g. V4's explicit plan) are what we measure. Empty = provider default.
GEMINI_THINKING_LEVEL=minimal
GROQ_REASONING_EFFORT=low     # only sent to openai/gpt-oss-* models
MAX_OUTPUT_TOKENS=1024
CALL_DELAY_SECONDS=2.0        # pause between API calls (free-tier rate limits)
MAX_API_RETRIES=5             # retries with exponential backoff on rate-limit/server errors

# --- Safety layer ---
QUERY_TIMEOUT_SECONDS=5
ROW_LIMIT=500
